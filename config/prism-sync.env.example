# PRISM RetailMind Sync Layer Environment Variables
# Location on target host: /etc/prism-sync/prism-sync.env (mode 640, root:prism-sync)

# RabbitMQ AMQP Connection URL
RABBIT_URL=amqp://prism_sync:PRISM_SYNC_PASSWORD@127.0.0.1:5672/prism
RABBIT_EXCHANGE=prism.sync

# PostgreSQL Database Connections
# DSN to Odoo database (requires SELECT and UPDATE on prism_sync_outbox)
ODOO_RO_DSN=host=127.0.0.1 dbname=odoo user=prism_sync password=DB_PASSWORD

# DSN to PRISM Sync bookkeeping database
SYNC_DSN=host=127.0.0.1 dbname=prism_sync user=prism_sync password=DB_PASSWORD

# Saleor GraphQL API Endpoint & App Token
SALEOR_GRAPHQL=http://127.0.0.1:8000/graphql/
SALEOR_APP_TOKEN=UNThVvs73naqLzx7kMU4xYynShDObZ

# Relay Tuning
RELAY_POLL_INTERVAL=5.0
RELAY_BATCH_SIZE=100

